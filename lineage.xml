<?xml version="1.0" encoding="UTF-8"?>
<ETLLineage version="1.0">

  <Job id="ETL_001" name="HESAP_TO_RISK" schedule="DAILY">
    <Source schema="CORE_BANKING" table="XXX_HESAP">
      <Column>HESAP_NO</Column>
      <Column>MUSTERI_NO</Column>
      <Column>HESAP_DURUM_KOD</Column>
    </Source>
    <Target schema="RISK" table="RISK_IZLEME">
      <Column>MUSTERI_NO</Column>
      <Column>RISK_SINIF</Column>
    </Target>
    <Transformation>Hesap durum kodu üzerinden risk sınıfı türetilir.</Transformation>
  </Job>

  <Job id="ETL_002" name="KREDI_TO_RISK" schedule="DAILY">
    <Source schema="CREDIT" table="KRD_MUS_KREDI">
      <Column>MUSTERI_NO</Column>
      <Column>KRD_DURUM</Column>
      <Column>KRD_TUTAR</Column>
    </Source>
    <Target schema="RISK" table="RISK_IZLEME">
      <Column>MUSTERI_NO</Column>
      <Column>RISK_SKOR</Column>
    </Target>
    <Transformation>Kredi tutarı ve duruma göre risk skoru hesaplanır.</Transformation>
  </Job>

  <Job id="ETL_003" name="RISK_TO_CRM" schedule="WEEKLY">
    <Source schema="RISK" table="RISK_IZLEME">
      <Column>MUSTERI_NO</Column>
      <Column>RISK_SKOR</Column>
      <Column>RISK_SINIF</Column>
    </Source>
    <Target schema="CRM" table="MUS_SEGMENTASYON">
      <Column>MUSTERI_NO</Column>
      <Column>SEGMENT_KOD</Column>
    </Target>
    <Transformation>Risk skoru baz alınarak müşteri segmenti güncellenir.</Transformation>
    <LoopWarning>Circular dependency: CRM -> RISK -> CRM via ETL_004</LoopWarning>
  </Job>

  <Job id="ETL_004" name="CRM_TO_RISK_FEEDBACK" schedule="WEEKLY">
    <Source schema="CRM" table="MUS_SEGMENTASYON">
      <Column>MUSTERI_NO</Column>
      <Column>GELIR_GRUBU</Column>
    </Source>
    <Target schema="RISK" table="RISK_IZLEME">
      <Column>MUSTERI_NO</Column>
      <Column>RISK_SKOR</Column>
    </Target>
    <Transformation>Gelir grubu risk skorunu etkiler (feedback loop).</Transformation>
    <LoopRisk>true</LoopRisk>
  </Job>

  <Job id="ETL_005" name="HESAP_TO_CRM" schedule="DAILY">
    <Source schema="CORE_BANKING" table="XXX_HESAP">
      <Column>MUSTERI_NO</Column>
      <Column>HESAP_TIP_KOD</Column>
      <Column>ACILIS_TARIHI</Column>
    </Source>
    <Target schema="CRM" table="MUS_SEGMENTASYON">
      <Column>MUSTERI_NO</Column>
      <Column>SEGMENT_KOD</Column>
    </Target>
    <Transformation>Hesap tipi ve açılış tarihine göre segment kodu belirlenir.</Transformation>
  </Job>

</ETLLineage>
